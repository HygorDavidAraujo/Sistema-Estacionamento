# Consulte também ../.env.example. Não substitua um .env existente sem preservar seus valores.
DATABASE_URL=postgres://user:password@host:5432/database
PGSSLMODE=require
PG_CONNECTION_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=15000
APP_TIMEZONE=America/Sao_Paulo
PORT=3000

# Código exclusivo para criar o primeiro administrador na hospedagem.
# AUTH_SETUP_TOKEN=
# ALLOWED_ORIGINS=https://seu-dominio.example

# Passo 4: backup MANUAL, sem conectar armazenamento externo ou agendamento.
# Gere os dois segredos opcionais no seu computador com npm run setup:secrets.
# BACKUP_ENCRYPTION_KEY=64_caracteres_hexadecimais
# AUTH_RECOVERY_TOKEN=segredo_exclusivo_de_uso_unico_para_recuperar_administrador
# BACKUP_AUTOMATIC_ENABLED=false
# Somente para recuperação manual em outra base vazia; não configure no Vercel:
# RECOVERY_DATABASE_URL=
# RECOVERY_CONFIRM=BANCO_VAZIO

# API gratuita com cota mensal pequena, em fase Alpha.
VEHICLE_LOOKUP_PROVIDER=parallelum
# FIPE_SUBSCRIPTION_TOKEN=
VEHICLE_CACHE_DAYS=30

# Leitura da câmera no dispositivo não precisa de chave.
# Plate Recognizer opcional:
# ANPR_API_KEY=
# ANPR_URL=https://api.platerecognizer.com/v1/plate-reader/
