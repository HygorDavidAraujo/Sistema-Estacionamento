# Banco de dados. Variáveis do ambiente de hospedagem têm precedência.
DATABASE_URL=postgres://user:password@host:5432/database
PGSSLMODE=require
PG_CONNECTION_TIMEOUT_MS=15000
PG_QUERY_TIMEOUT_MS=15000
APP_TIMEZONE=America/Sao_Paulo
PORT=3000

# Código exclusivo para criar o primeiro administrador na hospedagem.
# Localmente, um código temporário é exibido no terminal. Não há senha padrão.
# AUTH_SETUP_TOKEN=
# ALLOWED_ORIGINS=https://seu-dominio.example

# Consulta pela placa: retorna marca, modelo e cor quando disponíveis.
# Parallelum Alpha: 5 consultas/mês sem token; 10 com token gratuito.
# Documentação: https://fipe.api.br/docs/api/busca-por-placa-alpha
VEHICLE_LOOKUP_PROVIDER=parallelum
# FIPE_SUBSCRIPTION_TOKEN=
VEHICLE_CACHE_DAYS=30

# Alternativas opcionais, com cobrança do próprio fornecedor:
# VEHICLE_LOOKUP_PROVIDER=simplesapi
# SIMPLES_API_KEY=
# VEHICLE_LOOKUP_PROVIDER=apiplacas
# API_PLACAS_TOKEN=

# Câmera: OCR gratuito no navegador, inclusive no celular.
# A primeira leitura baixa o modelo do Tesseract; requer internet inicialmente.
# ANPR na nuvem é opcional e só é usado quando a leitura local não encontra placa.
# ANPR_API_KEY=
# ANPR_URL=https://api.platerecognizer.com/v1/plate-reader/
